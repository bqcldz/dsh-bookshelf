{
  "name": "@local/dsh-bookshelf",
  "version": "0.3.0",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./CHANGELOG.md": "./CHANGELOG.md",
    "./README.md": "./README.md",
    "./LICENSE": "./LICENSE"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "samples/*.epub"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "description": "DeepSeek Harness 本地图书管理插件：上传图书、书架展示，点书跳转原生会话由书架助手领读，读书记忆以 Markdown 数据库持久化。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bqcldz/dsh-bookshelf.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "bookshelf",
    "reading",
    "library"
  ],
  "license": "MIT",
  "author": "方志豪 (bqcldz)"
}
